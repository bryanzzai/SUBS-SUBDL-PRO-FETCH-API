<Window x:Class="SubdlProDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubDL Pro Download"
        Height="760"
        Width="1120"
        MinHeight="600"
        MinWidth="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SubDL Pro Download" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,16" Foreground="DimGray"
                           Text="Find and download English .srt sidecars from SubDL for the videos in a library."/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Top" Foreground="DimGray" FontSize="11"
                       Text="{Binding ReleaseLabel}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Video library"/>
                <TextBox x:Name="LibraryPathTextBox" Grid.Column="1" MinHeight="34"
                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                         ToolTip="Root folder of the video library"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Padding="16,7" Margin="0,0,8,0"
                        Content="Browse…" Click="BrowseButton_Click"/>
                <Button x:Name="ScanButton" Grid.Column="3" Padding="16,7" Margin="0,0,8,0"
                        Content="Scan" Click="ScanButton_Click"/>
                <Button x:Name="DownloadButton" Grid.Column="4" Padding="16,7"
                        Content="Download missing English subtitles" Click="DownloadButton_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="SubDL Pro API key"/>
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="ApiKeyTextBox" MinHeight="34" VerticalContentAlignment="Center"
                             ToolTip="Paste a replacement API key here. Leave blank to use the saved key."/>
                    <TextBlock Margin="0,4,0,0" Foreground="DimGray" FontSize="11"
                               Text="Leave this blank after the first successful run. Paste a replacement key here only if SubDL rejects the saved one."/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DataGrid x:Name="VideoGrid" Grid.Row="2" ItemsSource="{Binding Videos}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Video" Binding="{Binding FileName}" Width="3*"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*"/>
                <DataGridTextColumn Header="Subtitle" Binding="{Binding SubtitleDisplay}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="6"
                             Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" Margin="16,0"
                       VerticalAlignment="Center" Foreground="DimGray" Text="0 videos"/>
            <Button x:Name="CancelButton" Grid.Column="2" Padding="14,6" Content="Cancel"
                    IsEnabled="False" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
