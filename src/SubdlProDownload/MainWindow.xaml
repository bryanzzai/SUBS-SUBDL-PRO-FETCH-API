<Window x:Class="SubdlProDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubDL Pro Download"
        Height="890"
        Width="1180"
        MinHeight="680"
        MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="155"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SubDL Pro Download" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,16" Foreground="DimGray"
                           Text="Find English .srt sidecars by title and episode—not just an exact release filename."/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Top" Foreground="DimGray" FontSize="11"
                       Text="{Binding ReleaseLabel}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Video library"/>
                <TextBox x:Name="LibraryPathTextBox" Grid.Column="1" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Padding="14,7" Margin="0,0,8,0" Content="Browse…" Click="BrowseButton_Click"/>
                <Button x:Name="ScanButton" Grid.Column="3" Padding="14,7" Margin="0,0,8,0" Content="Scan" Click="ScanButton_Click"/>
                <Button x:Name="FindTitlesButton" Grid.Column="4" Padding="14,7" Margin="0,0,8,0" Content="Find title matches" Click="FindTitlesButton_Click"/>
                <Button x:Name="DownloadButton" Grid.Column="5" Padding="14,7" Content="Download selected subtitles" Click="DownloadButton_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="SubDL Pro API key"/>
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="ApiKeyTextBox" MinHeight="34" VerticalContentAlignment="Center"
                             ToolTip="Paste a replacement API key here. Leave blank to use the saved key."/>
                    <TextBlock Margin="0,4,0,0" Foreground="DimGray" FontSize="11"
                               Text="Scan → Find title matches → choose the right show once → download all matching episodes."/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Choose the real SubDL title for each detected show / film" Padding="8" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding TitleMappings}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Detected title" Binding="{Binding SuggestedTitle}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Videos" Binding="{Binding Episodes}" Width="2*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="SubDL result — choose one" Width="4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Candidates}"
                                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          MinHeight="28"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Search status" Binding="{Binding Status}" Width="1.5*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DataGrid x:Name="VideoGrid" Grid.Row="3" ItemsSource="{Binding Videos}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Video" Binding="{Binding FileName}" Width="2.6*"/>
                <DataGridTextColumn Header="Detected media" Binding="{Binding DetectedMedia}" Width="2.2*"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2.4*"/>
                <DataGridTextColumn Header="Subtitle" Binding="{Binding SubtitleDisplay}" Width="1.6*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
                <ProgressBar x:Name="ProgressBar" Margin="0,6,12,0" Height="6" Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="DimGray" Text="0 videos"/>
            <Button x:Name="CancelButton" Grid.Column="2" Padding="14,6" Content="Cancel" IsEnabled="False" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
